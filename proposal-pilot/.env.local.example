# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# AI mode
# Use live for real Perplexity-backed calls. Use mock for local demos without API calls.
AI_MODE=live
NEXT_PUBLIC_AI_MODE=live

# Feature flags
NEXT_PUBLIC_ONBOARDING_LADDER_ENABLED=true

# Perplexity AI — ONLY AI provider
# Covers Agent API, Sonar API, and Embeddings API
PERPLEXITY_API_KEY=your_key_here

# SAM.gov public API key — used to fetch full solicitation descriptions and
# attachments (SOW, Sections L/M, amendments) when analyzing discovery-sourced
# RFPs. Get one at sam.gov/profile → Account Details → Public API Key.
SAM_GOV_API_KEY=your_sam_key_here
